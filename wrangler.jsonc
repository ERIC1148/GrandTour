{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must stay in sync with the Worker that Cloudflare's GitHub integration
  // created from the repo name, or `wrangler deploy` silently spawns a second
  // Worker and secrets land on the wrong one.
  "name": "grandtour",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-01",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Client-side routing: any path that isn't a real file serves index.html.
    "not_found_handling": "single-page-application",
    // `/env.js` is generated by the Worker, not a build artifact, so the asset
    // server must not swallow it and return index.html instead.
    "run_worker_first": ["/env.js"]
  },

  "observability": {
    "enabled": true
  }

  // SUPABASE_URL and SUPABASE_ANON_KEY are set per-deployment, not committed:
  //   npx wrangler secret put SUPABASE_URL
  //   npx wrangler secret put SUPABASE_ANON_KEY
  // or in the dashboard under Workers > grandtour > Settings > Variables.
}
